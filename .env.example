# --- Banco (obrigatório) -------------------------------------------------------
POSTGRES_USER=carwatch
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=carwatch

# --- Rede ----------------------------------------------------------------------
# 127.0.0.1 = só o próprio host. Para o Tailscale, use o IP 100.x do host
# (`tailscale ip -4`) ou mantenha 127.0.0.1 e use `tailscale serve --bg 8000`.
BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# --- Imagem (deploy via GHCR) --------------------------------------------------
TAG=latest

# --- Comportamento -------------------------------------------------------------
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
HTTP_MIN_DELAY=3
HTTP_MAX_DELAY=5
HTTP_CACHE_TTL=1800

# --- FIPE (opcional) -----------------------------------------------------------
# Funciona sem token; um token gratuito de fipe.online aumenta a cota diária.
FIPE_TOKEN=

# --- Telegram (opcional) -------------------------------------------------------
# @BotFather → /newbot → token. Chat id: mande uma mensagem ao bot e abra
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
